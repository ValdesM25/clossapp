# Supabase — URL de tu proyecto y clave anónima pública
NEXT_PUBLIC_SUPABASE_URL="https://tu_proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu_anon_key"

# Anthropic — Claude API key (Sonnet 4.6 + Haiku)
ANTHROPIC_API_KEY="tu_api_key"

# Cloudflare Turnstile — site key pública del widget CAPTCHA del login.
# La clave secreta NO va aquí: se pega en Supabase (Auth > Attack Protection).
# Si se deja vacía, el login funciona sin CAPTCHA (solo para desarrollo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Botones de login social visibles. Agregar cada proveedor solo después de activarlo en Supabase.
# Ej. NEXT_PUBLIC_LOGIN_SOCIAL="google,facebook"
NEXT_PUBLIC_LOGIN_SOCIAL=""
