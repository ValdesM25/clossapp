# Supabase — URL de tu proyecto y clave anónima pública
NEXT_PUBLIC_SUPABASE_URL="https://tu_proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu_anon_key"

# Anthropic — Claude API key (Sonnet 4.6 + Haiku)
ANTHROPIC_API_KEY="tu_api_key"

# Cloudflare Turnstile — site key pública del widget CAPTCHA del login.
# La clave secreta NO va aquí: se pega en Supabase (Auth > Attack Protection).
# Si se deja vacía, el login funciona sin CAPTCHA (solo para desarrollo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Botones de login social visibles. Agregar cada proveedor solo después de activarlo en Supabase.
# Ej. NEXT_PUBLIC_LOGIN_SOCIAL="google,facebook"
NEXT_PUBLIC_LOGIN_SOCIAL=""

# Notificaciones push (recordatorio "¿compraste algo nuevo?").
# Generar el par de llaves una vez con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto que exige el estándar VAPID, ej. "mailto:hola@tudominio.com"
VAPID_SUBJECT=""
# Solo en el servidor (Vercel). Nunca con NEXT_PUBLIC_. Permite al envío leer todas las suscripciones.
SUPABASE_SERVICE_ROLE_KEY=""
# Secreto que manda el disparador diario (Vercel Cron o pg_cron) a /api/push/enviar.
CRON_SECRET=""

# Stripe (solo servidor; nunca con NEXT_PUBLIC_). Empezar con llaves de prueba (sk_test_…).
STRIPE_SECRET_KEY=
# Secreto del endpoint /api/stripe/webhook (whsec_…), del dashboard o de `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# IDs de los precios mensuales en MXN (price_…).
STRIPE_PRICE_PLUS=
STRIPE_PRICE_ELITE=
